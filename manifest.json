{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.1.0",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "__MSG_extName__" },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["https://drive.google.com/*"], "js": ["content.js"] }],
  "permissions": ["identity", "sidePanel", "scripting"],
  "host_permissions": ["https://drive.google.com/*"],
  "oauth2": {
    "client_id": "309966989459-u5mnnqrqkn1gs06q3gr79jjvb6omcik2.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/drive"]
  }
}
